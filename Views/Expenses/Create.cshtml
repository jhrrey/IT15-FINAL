@model FinSight.Models.Expense
@{
    ViewData["Title"] = "Record Expense";
}

<style>
    .expense-shell {
        max-width: 1040px;
        margin: 0 auto;
    }
    .expense-card, .budget-summary {
        background: var(--card-bg, #fff);
        border: 1px solid rgba(155,168,184,0.18);
        border-radius: 12px;
        box-shadow: 0 2px 14px rgba(8,11,17,0.06);
    }
    .expense-card .card-header {
        background: transparent;
        border-bottom: 1px solid #e7eaef;
        padding: 22px 26px 16px;
    }
    .expense-card .card-body {
        padding: 26px;
    }
    .budget-summary {
        padding: 20px;
        position: sticky;
        top: 86px;
    }
    .summary-label {
        color: #9ba8b8;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .summary-value {
        color: #162229;
        font-weight: 800;
        font-size: 1.08rem;
    }
    .summary-grid {
        display: grid;
        gap: 12px;
        margin-top: 16px;
    }
    .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e7eaef;
    }
    .summary-row:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }
    .utilization-track {
        height: 10px;
        border-radius: 999px;
        background: #e7eaef;
        overflow: hidden;
        margin-top: 16px;
    }
    .utilization-fill {
        width: 0%;
        height: 100%;
        background: #05828e;
        transition: width 0.25s ease, background 0.25s ease;
    }
    .budget-state {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 0.76rem;
        font-weight: 800;
    }
    .budget-state.healthy { background: rgba(5,130,142,0.12); color: #05828e; }
    .budget-state.warning { background: rgba(243,156,18,0.14); color: #a16207; }
    .budget-state.danger { background: rgba(231,76,60,0.12); color: #c0392b; }
    .budget-empty {
        color: #9ba8b8;
        font-size: 0.88rem;
        line-height: 1.45;
    }
    .client-error {
        display: none;
        color: #c0392b;
        font-size: 0.84rem;
        font-weight: 600;
        margin-top: 8px;
    }
    .context-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 999px;
        padding: 6px 10px;
        background: #e7eaef;
        color: #162229;
        font-size: 0.78rem;
        font-weight: 700;
    }
    @@media (max-width: 991.98px) {
        .budget-summary {
            position: static;
        }
    }
</style>

<div class="expense-shell">
    <div class="mb-4">
        <a asp-action="Index" class="text-muted text-decoration-none" style="font-size: 0.85rem;">
            <i class="bi bi-arrow-left me-1"></i> Back to Expenses
        </a>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-7">
            <div class="expense-card">
                <div class="card-header">
                    <h4 class="mb-1 fw-bold" style="color:#162229;">Record Actual Expense</h4>
                    <p class="text-muted mb-0" style="font-size: 0.86rem;">Log official spend against an approved budget allocation.</p>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" id="expenseForm" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="BudgetID" class="form-label fw-semibold">Target Budget Allocation <span class="text-danger">*</span></label>
                            <select asp-for="BudgetID" class="form-select" asp-items="ViewBag.BudgetID" id="budgetSelect" required>
                                <option value="">Select approved budget</option>
                            </select>
                            <span asp-validation-for="BudgetID" class="text-danger" style="font-size: 0.82rem;"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BudgetRequestID" class="form-label fw-semibold">Linked Budget Request</label>
                            <select asp-for="BudgetRequestID" class="form-select" id="requestSelect" disabled>
                                <option value="">Select related request</option>
                            </select>
                            <div class="form-text">Approved requests can pre-fill the title, category, and amount.</div>
                            <span asp-validation-for="BudgetRequestID" class="text-danger" style="font-size: 0.82rem;"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ExpenseTitle" class="form-label fw-semibold">Expense Title <span class="text-danger">*</span></label>
                                <input asp-for="ExpenseTitle" class="form-control" id="expenseTitle" required placeholder="Software licenses Q3" />
                                <span asp-validation-for="ExpenseTitle" class="text-danger" style="font-size: 0.82rem;"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Category" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                                <input asp-for="Category" class="form-control" id="expenseCategory" required placeholder="IT Operations" />
                                <span asp-validation-for="Category" class="text-danger" style="font-size: 0.82rem;"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Amount" class="form-label fw-semibold">Amount <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">&#8369;</span>
                                    <input asp-for="Amount" class="form-control" id="expenseAmount" type="number" step="0.01" min="0.01" required />
                                </div>
                                <div class="client-error" id="amountError">Expense amount exceeds the remaining allocated budget.</div>
                                <span asp-validation-for="Amount" class="text-danger" style="font-size: 0.82rem;"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ExpenseDate" class="form-label fw-semibold">Expense Date <span class="text-danger">*</span></label>
                                <input asp-for="ExpenseDate" type="date" class="form-control" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="ExpenseDate" class="text-danger" style="font-size: 0.82rem;"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">Description / Notes <span class="text-danger">*</span></label>
                            <textarea asp-for="Description" class="form-control" id="expenseDescription" rows="3" required placeholder="Short, audit-friendly description of the expense"></textarea>
                            <span asp-validation-for="Description" class="text-danger" style="font-size: 0.82rem;"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <a asp-action="Index" class="btn btn-light border px-4" style="border-radius: 10px;">Cancel</a>
                            <button type="submit" class="btn text-white px-4" id="submitBtn" style="background: #05828e; border: none; border-radius: 10px; font-weight: 700;">
                                <i class="bi bi-check-lg me-1"></i> Record Expense
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <aside class="budget-summary" id="budgetSummary">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="summary-label">Budget Utilization</div>
                        <h5 class="fw-bold mb-0" style="color:#162229;">Allocation Summary</h5>
                    </div>
                    <span class="budget-state healthy" id="budgetState"><i class="bi bi-circle-fill"></i> Healthy</span>
                </div>

                <div class="budget-empty mt-3" id="budgetEmpty">
                    Select a target budget allocation to see allocated, used, remaining, and utilization details.
                </div>

                <div class="d-none" id="budgetDetails">
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <span class="context-chip"><i class="bi bi-building"></i><span id="budgetDepartment">Department</span></span>
                        <span class="context-chip"><i class="bi bi-tag"></i><span id="budgetCategory">Category</span></span>
                    </div>

                    <div class="summary-grid">
                        <div class="summary-row">
                            <span class="summary-label">Allocated Budget</span>
                            <span class="summary-value" id="allocatedValue">&#8369;0.00</span>
                        </div>
                        <div class="summary-row">
                            <span class="summary-label">Used Budget</span>
                            <span class="summary-value" id="usedValue">&#8369;0.00</span>
                        </div>
                        <div class="summary-row">
                            <span class="summary-label">Remaining Balance</span>
                            <span class="summary-value" id="remainingValue">&#8369;0.00</span>
                        </div>
                    </div>

                    <div class="utilization-track">
                        <div class="utilization-fill" id="utilizationFill"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <span class="summary-label">Utilization</span>
                        <strong id="utilizationValue" style="color:#162229;">0%</strong>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const peso = new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' });
        const budgetSelect = document.getElementById('budgetSelect');
        const requestSelect = document.getElementById('requestSelect');
        const amountInput = document.getElementById('expenseAmount');
        const amountError = document.getElementById('amountError');
        const submitBtn = document.getElementById('submitBtn');
        const form = document.getElementById('expenseForm');
        let remainingBudget = null;
        let selectedBudgetDetails = null;

        function stateFor(utilization, remaining) {
            if (remaining < 0 || utilization >= 90) return { name: 'Low / Over Budget', cls: 'danger', color: '#c0392b' };
            if (utilization >= 70) return { name: 'Nearing Limit', cls: 'warning', color: '#a16207' };
            return { name: 'Healthy', cls: 'healthy', color: '#05828e' };
        }

        function updateBudgetPanel(data) {
            selectedBudgetDetails = data;
            remainingBudget = Number(data.remaining);

            document.getElementById('budgetEmpty').classList.add('d-none');
            document.getElementById('budgetDetails').classList.remove('d-none');
            document.getElementById('budgetDepartment').innerText = data.department;
            document.getElementById('budgetCategory').innerText = data.category;
            refreshBudgetPreview();
            validateAmount();
        }

        function refreshBudgetPreview() {
            if (!selectedBudgetDetails) return;

            const allocated = Number(selectedBudgetDetails.total || 0);
            const committedUsed = Number(selectedBudgetDetails.used || 0);
            const pendingAmount = Math.max(Number(amountInput.value || 0), 0);
            const previewUsed = committedUsed + pendingAmount;
            const previewRemaining = allocated - previewUsed;
            const utilization = allocated > 0 ? Math.round((previewUsed / allocated) * 1000) / 10 : 0;
            const state = stateFor(utilization, previewRemaining);

            document.getElementById('allocatedValue').innerText = peso.format(allocated);
            document.getElementById('usedValue').innerText = peso.format(previewUsed);
            document.getElementById('remainingValue').innerText = peso.format(previewRemaining);
            document.getElementById('remainingValue').style.color = state.color;
            document.getElementById('utilizationValue').innerText = utilization + '%';
            document.getElementById('utilizationFill').style.width = Math.min(utilization, 100) + '%';
            document.getElementById('utilizationFill').style.background = state.color;

            const badge = document.getElementById('budgetState');
            badge.className = 'budget-state ' + state.cls;
            badge.innerHTML = '<i class="bi bi-circle-fill"></i> ' + state.name;
        }

        function validateAmount() {
            const amount = Number(amountInput.value || 0);
            const invalid = remainingBudget !== null && amount > remainingBudget;
            amountError.style.display = invalid ? 'block' : 'none';
            submitBtn.disabled = invalid;
            amountInput.setCustomValidity(invalid ? 'Expense amount exceeds the remaining allocated budget.' : '');
            refreshBudgetPreview();
            return !invalid;
        }

        async function loadBudget(budgetId) {
            requestSelect.innerHTML = '<option value="">Select related request</option>';
            requestSelect.disabled = true;
            remainingBudget = null;
            selectedBudgetDetails = null;
            document.getElementById('budgetEmpty').classList.remove('d-none');
            document.getElementById('budgetDetails').classList.add('d-none');

            if (!budgetId) return;

            const budgetRes = await fetch('/Expenses/GetBudgetDetails?budgetId=' + encodeURIComponent(budgetId));
            if (budgetRes.ok) {
                updateBudgetPanel(await budgetRes.json());
            }

            const requestsRes = await fetch('/Expenses/GetRequestsByBudget?budgetId=' + encodeURIComponent(budgetId));
            if (requestsRes.ok) {
                const requests = await requestsRes.json();
                requests.forEach(req => {
                    const option = document.createElement('option');
                    option.value = req.requestID;
                    option.text = req.title + ' (' + peso.format(req.requestedAmount) + ')';
                    option.dataset.title = req.title || '';
                    option.dataset.description = req.description || '';
                    option.dataset.amount = req.requestedAmount || '';
                    option.dataset.category = req.category || '';
                    requestSelect.appendChild(option);
                });
                requestSelect.disabled = requests.length === 0;
            }
        }

        budgetSelect.addEventListener('change', e => loadBudget(e.target.value));
        amountInput.addEventListener('input', validateAmount);

        requestSelect.addEventListener('change', function () {
            const selected = this.selectedOptions[0];
            if (!selected || !selected.value) return;

            if (!document.getElementById('expenseTitle').value) {
                document.getElementById('expenseTitle').value = selected.dataset.title;
            }
            if (!document.getElementById('expenseCategory').value) {
                document.getElementById('expenseCategory').value = selected.dataset.category;
            }
            if (!document.getElementById('expenseDescription').value && selected.dataset.description) {
                document.getElementById('expenseDescription').value = selected.dataset.description;
            }
            if (!amountInput.value && selected.dataset.amount) {
                amountInput.value = selected.dataset.amount;
            }
            validateAmount();
        });

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!validateAmount() || !form.checkValidity()) {
                form.classList.add('was-validated');
                if (!validateAmount()) amountInput.focus();
                return;
            }

            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Recording...';

            fetch(form.action, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new FormData(form)
            }).then(async res => {
                const payload = await res.json().catch(() => ({}));
                if (res.ok) {
                    Swal.fire({
                        title: 'Expense Recorded Successfully',
                        text: 'The actual expense has been securely logged.',
                        icon: 'success',
                        confirmButtonColor: '#05828e'
                    }).then(() => {
                        window.location.href = payload.redirectUrl || '@Url.Action("Index", "Expenses")';
                    });
                } else {
                    Swal.fire('Error', payload.message || 'An error occurred while recording the expense. Please ensure all fields are valid.', 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            }).catch(err => {
                Swal.fire('Error', 'Network error occurred.', 'error');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            });
        });

        if (budgetSelect.value) {
            loadBudget(budgetSelect.value);
        }
    </script>
}
